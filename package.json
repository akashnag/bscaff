{
	"name": "@akashnag/bscaff",
	"version": "0.0.1",
	"description": "CLI tool to save and recall code snippets, files, and directory scaffolding",
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"scaffold": "./bin/index.js"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"build": "tsc",
		"start": "npm run build && node bin/index.js",
		"prepublishOnly": "npm run build",
		"lint": "eslint .",
		"biome:format": "biome format --write .",
		"dev": "tsc --watch & node --watch bin/index.js"
	},
	"keywords": [
		"cli",
		"scaffolding",
		"typescript",
		"generator"
	],
	"author": "Akash Nag",
	"license": "GPL-2.0-only",
	"dependencies": {
		"chalk": "^6.0.0",
		"commander": "^12.0.0",
		"isbinaryfile": "^5.0.7",
		"ora": "^9.4.1",
		"simple-git": "^3.36.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@eslint/js": "^9.39.5",
		"@types/node": "^20.0.0",
		"eslint": "^9.39.5",
		"eslint-config-biome": "^2.1.3",
		"globals": "^17.12.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0"
	}
}
