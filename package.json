{
	"name": "@akashnag/bscaff",
	"version": "0.0.1",
	"description": "CLI tool to save and recall code snippets, files, and directory scaffolding",
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"scaffold": "./bin/index.js"
	},
	"scripts": {
		"build": "tsc",
		"start": "npm run build && node bin/index.js",
		"dev": "npm run build && node bin/index.js",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"cli",
		"scaffolding",
		"typescript",
		"generator"
	],
	"author": "Akash Nag",
	"license": "GPL-2.0-only",
	"dependencies": {
		"commander": "^12.0.0",
		"isbinaryfile": "^5.0.7",
		"tar": "^7.5.22"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.9.3"
	}
}
