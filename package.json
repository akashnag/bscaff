{
	"name": "@akashnag/bscaff",
	"version": "0.1.0",
	"description": "A project scaffolding and snippet manager CLI for saving and reusing code snippets, files, directory structures, and offline project templates.",
	"homepage": "https://github.com/akashnag/bscaff",
	"main": "dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=22.11.0"
	},
	"bin": {
		"bscaff": "./bin/index.js"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"build": "tsc",
		"start": "npm run build && node bin/index.js",
		"prepack": "npm run build",
		"prepublishOnly": "npm run build",
		"lint": "eslint .",
		"biome:format": "biome format --write .",
		"dev": "tsc --watch & node --watch bin/index.js",
		"test": "npm run build && vitest",
		"test:run": "npm run build && vitest run",
		"build:completions": "npm run build && tsx scripts/generate-completions.ts"
	},
	"keywords": [
		"cli",
		"scaffolding",
		"project-scaffolding",
		"project-generator",
		"project-template",
		"template-engine",
		"code-snippets",
		"snippet-manager",
		"boilerplate",
		"file-template",
		"directory-structure",
		"offline-templates"
	],
	"author": "Akash Nag",
	"license": "GPL-2.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akashnag/bscaff"
	},
	"dependencies": {
		"@inquirer/prompts": "^7.10.1",
		"adm-zip": "^0.6.1",
		"chalk": "^6.0.0",
		"commander": "^12.0.0",
		"fuzzball": "^2.2.6",
		"isbinaryfile": "^5.0.7",
		"minimatch": "^10.2.6",
		"nunjucks": "^3.2.4",
		"ora": "^9.4.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@eslint/js": "^9.39.5",
		"@types/node": "^20.19.43",
		"@types/nunjucks": "^3.2.6",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^9.39.5",
		"eslint-config-biome": "^2.1.3",
		"execa": "^10.0.1",
		"globals": "^17.12.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^4.1.11"
	}
}
