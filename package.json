{
	"name": "@akashnag/bscaff",
	"version": "0.0.1",
	"description": "CLI tool to save and recall code snippets, files, and directory scaffolding",
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"scaffold": "./bin/index.js"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"build": "tsc",
		"start": "npm run build && node bin/index.js",
		"prepublishOnly": "npm run build",
		"lint": "eslint .",
		"biome:format": "biome format --write .",
		"dev": "tsc --watch & node --watch bin/index.js",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"build:completions": "npm run build && tsx scripts/generate-completions.ts"
	},
	"keywords": [
		"cli",
		"scaffolding",
		"typescript",
		"generator"
	],
	"author": "Akash Nag",
	"license": "GPL-2.0-only",
	"dependencies": {
		"@inquirer/prompts": "^7.10.1",
		"adm-zip": "^0.6.1",
		"chalk": "^6.0.0",
		"commander": "^12.0.0",
		"fuzzball": "^2.2.6",
		"isbinaryfile": "^5.0.7",
		"nunjucks": "^3.2.4",
		"ora": "^9.4.1",
		"simple-git": "^3.36.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@eslint/js": "^9.39.5",
		"@types/node": "^20.19.43",
		"@types/nunjucks": "^3.2.6",
		"eslint": "^9.39.5",
		"eslint-config-biome": "^2.1.3",
		"execa": "^10.0.1",
		"globals": "^17.12.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11"
	}
}
