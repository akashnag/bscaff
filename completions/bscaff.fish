# Fish completion for bscaff

complete -c bscaff -n "__fish_use_subcommand" -a "save" -d "Save snapshots"
complete -c bscaff -n "__fish_seen_subcommand_from save"  -l desc -d "Brief description of the snapshot (in double-quotes)"
complete -c bscaff -n "__fish_seen_subcommand_from save"  -l tags -d "List of tags (comma-separated, no spaces) associated with this snapshot"
complete -c bscaff -n "__fish_use_subcommand" -a "settings" -d "Opens bscaff settings for editing"
complete -c bscaff -n "__fish_use_subcommand" -a "update" -d "Update snapshot metadata"
complete -c bscaff -n "__fish_use_subcommand" -a "delete" -d "Delete snapshot, or a file under the snapshot"
complete -c bscaff -n "__fish_seen_subcommand_from delete" -s f -l force -d "Delete without confirmation"
complete -c bscaff -n "__fish_use_subcommand" -a "search" -d "Searches for a snapshot with a key similar to one provided"
complete -c bscaff -n "__fish_seen_subcommand_from search"  -l desc -d "Description (approximate) to match (in double-quotes)"
complete -c bscaff -n "__fish_seen_subcommand_from search"  -l type -d "Filter by snapshot type (exact)"
complete -c bscaff -n "__fish_seen_subcommand_from search"  -l tags -d "Filter by tags (exact, separated by commas, no spaces)"
complete -c bscaff -n "__fish_use_subcommand" -a "list" -d "Lists the saved snapshots"
complete -c bscaff -n "__fish_seen_subcommand_from list"  -l type -d "Filter by snapshot type (exact)"
complete -c bscaff -n "__fish_seen_subcommand_from list"  -l tags -d "Filter by tags (separated by commas, no spaces)"
complete -c bscaff -n "__fish_use_subcommand" -a "copy" -d "Copy the snippet / file-tree (ASCII) / file-list / URL / file-contents (if path specified) to clipboard"
complete -c bscaff -n "__fish_seen_subcommand_from copy"  -l as-tree -d "If snapshot is a template or a tree, copy the structure as an ASCII-tree instead of list of file-paths"
complete -c bscaff -n "__fish_use_subcommand" -a "open" -d "Opens a URL in the browser; a snippet in a text-editor (read-only), or a file (from tree / template / files) in the default application (read-only)"
complete -c bscaff -n "__fish_seen_subcommand_from open"  -l editor -d "Force file (from tree / template / files) to be open in the text-editor"
complete -c bscaff -n "__fish_seen_subcommand_from open" -s c -l command -d "Use custom app to open file, use double-quotes"
complete -c bscaff -n "__fish_use_subcommand" -a "extract" -d "Extracts a tree / files / template to the directory path"
complete -c bscaff -n "__fish_seen_subcommand_from extract"  -l partial -d "Extract the snapshot partially under path specified by <rel-path>"
complete -c bscaff -n "__fish_seen_subcommand_from extract"  -l dry-run -d "Do a dry-run without actually performing the extraction"
complete -c bscaff -n "__fish_seen_subcommand_from extract" -s e -l if-exists -d "Behaviour if destination file exists"
complete -c bscaff -n "__fish_use_subcommand" -a "create" -d "Creates files and trees from content copied to clipboard"
complete -c bscaff -n "__fish_use_subcommand" -a "template" -d "Save/create/generate templates"
