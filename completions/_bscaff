#compdef bscaff

_bscaff() {
    local -a commands
    commands=(
        'save:Save snapshots'
        'settings:Opens bscaff settings for editing'
        'update:Update snapshot metadata'
        'delete:Delete snapshot, or a file under the snapshot'
        'search:Searches for a snapshot with a key similar to one provided'
        'list:Lists the saved snapshots'
        'copy:Copy the snippet / file-tree (ASCII) / file-list / URL / file-contents (if path specified) to clipboard'
        'open:Opens a URL in the browser; a snippet or a file (from tree, template, files) in a text-editor (read-only)'
        'extract:Extracts a tree / files / template to the directory path'
        'create:Creates files and trees from content copied to clipboard'
        'transform:Transform external files'
        'template:Save/create/execute templates'
    )

    _arguments -C \
        '1: :->_cmds' \
        '*::arg:->args'

    case $state in
        _cmds)
            _describe -t commands 'bscaff command' commands
            ;;
        args)
            case $line[1] in
                save)
                    _values 'flags' '--desc[Brief description of the snapshot (in double-quotes)]' '--tags[List of tags (comma-separated, no spaces) associated with this snapshot]'
                    ;;
                settings)
                    _values 'flags' 
                    ;;
                update)
                    _values 'flags' 
                    ;;
                delete)
                    _values 'flags' 
                    ;;
                search)
                    _values 'flags' '--desc[Description (approximate) to match (in double-quotes)]' '--type[Filter by snapshot type (exact)]' '--tags[Filter by tags (exact, separated by commas, no spaces)]'
                    ;;
                list)
                    _values 'flags' '--type[Filter by snapshot type (exact)]' '--tags[Filter by tags (separated by commas, no spaces)]'
                    ;;
                copy)
                    _values 'flags' '--as-tree[If snapshot is a template or a tree, copy the structure as an ASCII-tree instead of list of file-paths]'
                    ;;
                open)
                    _values 'flags' 
                    ;;
                extract)
                    _values 'flags' '--partial[Extract the snapshot partially under path specified by <rel-path>]' '--if-exists[Behaviour if destination file exists]'
                    ;;
                create)
                    _values 'flags' 
                    ;;
                transform)
                    _values 'flags' 
                    ;;
                template)
                    _values 'flags' 
                    ;;
            esac
            ;;
    esac
}

_bscaff "$@"
